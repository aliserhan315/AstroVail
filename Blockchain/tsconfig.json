{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "hardhat", "@nomicfoundation/hardhat-viem"],
    "outDir": "dist"
  },
  "include": [
    "hardhat.config.ts",
    "contracts",
    "test",
    "scripts",
    "ignition",
    "typechain-types"
  ],
  "exclude": ["node_modules"]
}
