{
  "compilerOptions": {
    "target": "es2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["node", "hardhat"],
    "skipLibCheck": true
  },
  "include": ["./hardhat.config.ts", "scripts", "test", "typechain-types", "types"],
  "exclude": ["node_modules"]
}
