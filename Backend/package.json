{
  "name": "astro-vail-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "cron:events": "node scripts/cr0n-fetch-events.js",
    "cron:events:once": "node scripts/cron-fetch-events.js --once",
    "cron:notifs": "node scripts/cron-send-notifs.js",
    "cron:notifs:once": "node scripts/cron-send-notifs.js --once",
    "stars:cleanup6p5": "node scripts/cleanup-to-6p5.js",
    "stars:enrich:names": "node scripts/enrich-names-simbad.js",
    "dev": "nodemon src/server.js",
    "import:gaia": "node scripts/seed-gaia.js",
    "start": "node src/server.js",
    "enrich:names": "node scripts/enrich-names-simbad.js",
    "format": "prettier --write .",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "ci": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --ci --coverage --runInBand"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "corn": "^0.0.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.0.0",
    "fast-xml-parser": "^5.2.5",
    "google-auth-library": "^10.3.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.1",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.0",
    "ngrok": "^5.0.0-beta.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "p-limit": "^7.1.0",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^10.0.0",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
